rules_version = '2';

// Cada docente solo puede leer y escribir SU propio registro.
// El identificador del documento es el uid de la cuenta que inició sesión.
service cloud.firestore {
  match /databases/{database}/documents {

    match /registros/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Todo lo demás queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
